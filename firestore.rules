             validString(data.key, 1, 200) &&
             data.key == key &&
             validString(data.paymentId, 1, 100) &&
             validString(data.createdAt, 1, 50);
    }

    function isValidInventoryMovement(data) {
      return hasRequiredFields(['id', 'propertyId', 'change']) &&
             hasOnlyAllowedFields([
               'id', 'organizationId', 'propertyId', 'itemId', 'itemName',
               'title', 'detail', 'change', 'quantity', 'delta', 'type',
               'movementType', 'unitCost', 'referenceType', 'referenceId',
               'department', 'issuedTo', 'fromLocation', 'toLocation',
               'reason', 'supplier', 'invoiceNumber', 'batchNumber',
               'expiryDate', 'cost', 'performedBy', 'performedById',
               'approvedBy', 'idempotencyKey', 'notes', 'timestamp',
               'createdAt', 'tone'
             ]) &&
             validString(data.id, 1, 100) &&
             validOptString('organizationId', 0, 100) &&
             validString(data.propertyId, 1, 100) &&
             data.change is number &&
             (!('quantity' in data) || data.quantity == null || (data.quantity is number && data.quantity >= 0)) &&
             validOptString('itemId', 0, 100) &&
             validOptString('itemName', 0, 150) &&
             validOptString('title', 0, 200) &&
             validOptString('detail', 0, 500) &&
             validOptString('delta', 0, 50) &&
             (!('type' in data) || data.type == null || data.type in [
               'Opening Stock', 'Purchase In', 'Issue Out', 'Return In',
               'Transfer Out', 'Transfer In', 'Adjustment In', 'Adjustment Out',
               'Purchase', 'Consumption', 'Damage', 'Adjustment', 'Transfer'
             ]) &&
             (!('movementType' in data) || data.movementType == null || data.movementType in [
               'Opening Stock', 'Purchase In', 'Issue Out', 'Return In',
               'Transfer Out', 'Transfer In', 'Adjustment In', 'Adjustment Out',
               'Purchase', 'Consumption', 'Damage', 'Adjustment', 'Transfer'
             ]) &&
             (!('unitCost' in data) || data.unitCost == null || (data.unitCost is number && data.unitCost >= 0)) &&
             (!('referenceType' in data) || data.referenceType == null || data.referenceType in ['PO', 'WorkOrder', 'Transfer', 'Housekeeping', 'Manual']) &&
             validOptString('referenceId', 0, 100) &&
             (!('department' in data) || data.department == null || data.department in ['Housekeeping', 'Maintenance', 'Reception', 'Kitchen', 'Other']) &&
             validOptString('issuedTo', 0, 150) &&
             validOptString('fromLocation', 0, 150) &&
             validOptString('toLocation', 0, 150) &&
             validOptString('reason', 0, 500) &&
             validOptString('supplier', 0, 150) &&
             validOptString('invoiceNumber', 0, 100) &&
             validOptString('batchNumber', 0, 100) &&
             validOptString('expiryDate', 0, 50) &&
             (!('cost' in data) || data.cost == null || (data.cost is number && data.cost >= 0)) &&
             validOptString('performedBy', 0, 150) &&
             validOptString('performedById', 0, 128) &&
             validOptString('approvedBy', 0, 150) &&
             validOptString('idempotencyKey', 0, 150) &&
             validOptString('notes', 0, 2000) &&
             validOptString('timestamp', 0, 50) &&
             validOptString('createdAt', 0, 50) &&
             validOptString('tone', 0, 50) &&
             (!('tone' in data) || data.tone == null || data.tone in ['success', 'warm', 'danger', 'primary', 'muted']);
    }

    function isValidMaintenanceRequest(data) {
      return hasRequiredFields([
               'id', 'organizationId', 'propertyId', 'category', 'title',
               'description', 'priority', 'status', 'reportedBy',
               'reportedByUid', 'reportedAt'
             ]) &&
             hasOnlyAllowedFields([
               'id', 'organizationId', 'propertyId', 'roomId', 'roomNumber',
               'areaName', 'category', 'title', 'description', 'priority',
               'status', 'photos', 'notes', 'markRoomOutOfService',
               'workOrderId', 'reportedBy', 'reportedByUid', 'reportedAt',
               'reviewedBy', 'reviewedAt', 'rejectionReason', 'updatedAt'
             ]) &&
             validString(data.id, 1, 100) &&
             validString(data.organizationId, 1, 100) &&
             validString(data.propertyId, 1, 100) &&
             validOptString('roomId', 0, 100) &&
             validOptString('roomNumber', 0, 50) &&
             validOptString('areaName', 0, 150) &&
             data.category in ['Electrical', 'Plumbing', 'AC and Cooling', 'Furniture', 'Appliances', 'Building', 'Internet', 'Other'] &&
             validString(data.title, 1, 200) &&
             validString(data.description, 1, 2000) &&
             data.priority in ['Low', 'Normal', 'High', 'Emergency'] &&
             data.status in ['Reported', 'Approved', 'Assigned', 'In Progress', 'Waiting for Parts', 'Completed', 'Verified', 'Rejected', 'Cancelled'] &&
             (!('photos' in data) || data.photos == null || (data.photos is list && data.photos.size() <= 20)) &&
             validOptString('notes', 0, 2000) &&
             (!('markRoomOutOfService' in data) || data.markRoomOutOfService == null || data.markRoomOutOfService is bool) &&
             validOptString('workOrderId', 0, 100) &&
             validString(data.reportedBy, 1, 150) &&
             validString(data.reportedByUid, 1, 128) &&
             validString(data.reportedAt, 1, 50) &&
             validOptString('reviewedBy', 0, 150) &&
             validOptString('reviewedAt', 0, 50) &&
             validOptString('rejectionReason', 0, 1000) &&
             validOptString('updatedAt', 0, 50);
    }

    function isValidWorkOrder(data) {
      return hasRequiredFields([
               'id', 'workOrderNumber', 'organizationId', 'propertyId',
               'category', 'priority', 'assignedTechnicianName',
               'repairDescription', 'issuedItems', 'labourCost',
               'materialCost', 'totalCost', 'status', 'createdBy',
               'createdByUid', 'createdAt'
             ]) &&
             hasOnlyAllowedFields([
               'id', 'workOrderNumber', 'requestId', 'organizationId',
               'propertyId', 'roomId', 'roomNumber', 'areaName', 'category',
               'priority', 'assignedTechnicianUid', 'assignedTechnicianName',
               'repairDescription', 'requiredParts', 'issuedItems',
               'linkedPurchaseOrderIds', 'labourCost', 'materialCost',
               'totalCost', 'status', 'completionNotes', 'beforePhotos',
               'afterPhotos', 'dueDate', 'createdBy', 'createdByUid',
               'createdAt', 'completedAt', 'verifiedBy', 'verifiedByUid',
               'verifiedAt', 'verificationNotes', 'updatedAt'
             ]) &&
             validString(data.id, 1, 100) &&
             validString(data.workOrderNumber, 1, 100) &&
             validOptString('requestId', 0, 100) &&
             validString(data.organizationId, 1, 100) &&
             validString(data.propertyId, 1, 100) &&
             validOptString('roomId', 0, 100) &&
             validOptString('roomNumber', 0, 50) &&
             validOptString('areaName', 0, 150) &&
             data.category in ['Electrical', 'Plumbing', 'AC and Cooling', 'Furniture', 'Appliances', 'Building', 'Internet', 'Other'] &&
             data.priority in ['Low', 'Normal', 'High', 'Emergency'] &&
             validOptString('assignedTechnicianUid', 0, 128) &&
             validString(data.assignedTechnicianName, 1, 150) &&
             validString(data.repairDescription, 1, 2000) &&
             validOptString('requiredParts', 0, 1000) &&
             data.issuedItems is list && data.issuedItems.size() <= 100 &&
             (!('linkedPurchaseOrderIds' in data) || data.linkedPurchaseOrderIds == null || (data.linkedPurchaseOrderIds is list && data.linkedPurchaseOrderIds.size() <= 50)) &&
             data.labourCost is number && data.labourCost >= 0 &&
             data.materialCost is number && data.materialCost >= 0 &&
             data.totalCost is number && data.totalCost >= 0 &&
             data.status in ['Assigned', 'In Progress', 'Waiting for Parts', 'Completed', 'Verified', 'Closed', 'Cancelled'] &&
             validOptString('completionNotes', 0, 2000) &&
             (!('beforePhotos' in data) || data.beforePhotos == null || (data.beforePhotos is list && data.beforePhotos.size() <= 20)) &&
             (!('afterPhotos' in data) || data.afterPhotos == null || (data.afterPhotos is list && data.afterPhotos.size() <= 20)) &&
             validOptString('dueDate', 0, 50) &&
             validString(data.createdBy, 1, 150) &&
             validString(data.createdByUid, 1, 128) &&
             validString(data.createdAt, 1, 50) &&
             validOptString('completedAt', 0, 50) &&
             validOptString('verifiedBy', 0, 150) &&
             validOptString('verifiedByUid', 0, 128) &&
             validOptString('verifiedAt', 0, 50) &&
             validOptString('verificationNotes', 0, 2000) &&
             validOptString('updatedAt', 0, 50);
    }

    function isValidSupplier(data) {
      return hasRequiredFields([
               'id', 'organizationId', 'name', 'contactPerson', 'phone',
               'suppliedCategories', 'status', 'createdAt'
             ]) &&
             hasOnlyAllowedFields([
               'id', 'organizationId', 'name', 'contactPerson', 'phone',
               'email', 'address', 'gstNumber', 'suppliedCategories',
               'notes', 'status', 'createdAt', 'updatedAt'
             ]) &&
             validString(data.id, 1, 100) &&
             validString(data.organizationId, 1, 100) &&
             validString(data.name, 1, 150) &&
             validString(data.contactPerson, 1, 150) &&
             validString(data.phone, 1, 50) &&
             (!('email' in data) || data.email == null || data.email == '' || isValidEmail(data.email)) &&
             validOptString('address', 0, 500) &&
             validOptString('gstNumber', 0, 50) &&
             data.suppliedCategories is list && data.suppliedCategories.size() <= 50 &&
             validOptString('notes', 0, 2000) &&
             data.status in ['Active', 'Inactive'] &&
             validString(data.createdAt, 1, 50) &&
             validOptString('updatedAt', 0, 50);
    }

    function isValidPurchaseOrder(data) {
      return hasRequiredFields([
               'id', 'poNumber', 'organizationId', 'propertyId', 'supplierId',
               'supplierName', 'items', 'subtotal', 'tax', 'discount',
               'total', 'status', 'createdBy', 'createdByUid', 'createdAt'
             ]) &&
             hasOnlyAllowedFields([
               'id', 'poNumber', 'organizationId', 'propertyId', 'supplierId',
               'supplierName', 'items', 'subtotal', 'tax', 'discount',
               'total', 'expectedDeliveryDate', 'status', 'linkedWorkOrderId',
               'expenseRecorded', 'expenseId', 'notes', 'createdBy',
               'createdByUid', 'approvedBy', 'approvedAt', 'createdAt',
               'updatedAt'
             ]) &&
             validString(data.id, 1, 100) &&
             validString(data.poNumber, 1, 100) &&
             validString(data.organizationId, 1, 100) &&
             validString(data.propertyId, 1, 100) &&
             validString(data.supplierId, 1, 100) &&
             validString(data.supplierName, 1, 150) &&
             data.items is list && data.items.size() <= 200 &&
             data.subtotal is number && data.subtotal >= 0 &&
             data.tax is number && data.tax >= 0 &&
             data.discount is number && data.discount >= 0 &&
             data.total is number && data.total >= 0 &&
             validOptString('expectedDeliveryDate', 0, 50) &&
             data.status in ['Draft', 'Pending Approval', 'Approved', 'Ordered', 'Partially Received', 'Received', 'Cancelled'] &&
             validOptString('linkedWorkOrderId', 0, 100) &&
             (!('expenseRecorded' in data) || data.expenseRecorded == null || data.expenseRecorded is bool) &&
             validOptString('expenseId', 0, 100) &&
             validOptString('notes', 0, 2000) &&
             validString(data.createdBy, 1, 150) &&
             validString(data.createdByUid, 1, 128) &&
             validOptString('approvedBy', 0, 150) &&
             validOptString('approvedAt', 0, 50) &&
             validString(data.createdAt, 1, 50) &&
             validOptString('updatedAt', 0, 50);
    }

    function isValidStockTransfer(data) {
      return hasRequiredFields([
               'id', 'organizationId', 'sourcePropertyId',
               'destinationPropertyId', 'sourceItemId', 'itemName', 'unit',
               'quantity', 'status', 'requestedBy', 'requestedByUid',
               'createdAt'
             ]) &&
             hasOnlyAllowedFields([
               'id', 'organizationId', 'sourcePropertyId', 'sourcePropertyName',
               'destinationPropertyId', 'destinationPropertyName', 'sourceItemId',
               'destinationItemId', 'itemName', 'sku', 'unit', 'quantity',
               'status', 'notes', 'requestedBy', 'requestedByUid',
               'approvedBy', 'approvedByUid', 'dispatchedAt', 'receivedBy',
               'receivedAt', 'rejectionReason', 'createdAt', 'updatedAt'
             ]) &&
             validString(data.id, 1, 100) &&
             validString(data.organizationId, 1, 100) &&
             validString(data.sourcePropertyId, 1, 100) &&
             validOptString('sourcePropertyName', 0, 150) &&
             validString(data.destinationPropertyId, 1, 100) &&
             validOptString('destinationPropertyName', 0, 150) &&
             validString(data.sourceItemId, 1, 100) &&
             validOptString('destinationItemId', 0, 100) &&
             validString(data.itemName, 1, 150) &&
             validOptString('sku', 0, 50) &&
             validString(data.unit, 1, 50) &&
             data.quantity is number && data.quantity > 0 &&
             data.status in ['Draft', 'Requested', 'Approved', 'Dispatched', 'Received', 'Rejected', 'Cancelled'] &&
             validOptString('notes', 0, 2000) &&
             validString(data.requestedBy, 1, 150) &&
             validString(data.requestedByUid, 1, 128) &&
             validOptString('approvedBy', 0, 150) &&
             validOptString('approvedByUid', 0, 128) &&
             validOptString('dispatchedAt', 0, 50) &&
             validOptString('receivedBy', 0, 150) &&
             validOptString('receivedAt', 0, 50) &&
             validOptString('rejectionReason', 0, 1000) &&
             validString(data.createdAt, 1, 50) &&
             validOptString('updatedAt', 0, 50);
    }

    function isValidStorageLocation(data) {
      return hasRequiredFields([
               'id', 'organizationId', 'propertyId', 'name', 'type',
               'status', 'createdAt'
             ]) &&
             hasOnlyAllowedFields([
               'id', 'organizationId', 'propertyId', 'name', 'code',
               'type', 'description', 'status', 'createdAt'
             ]) &&
             validString(data.id, 1, 100) &&
             validString(data.organizationId, 1, 100) &&
             validString(data.propertyId, 1, 100) &&
             validString(data.name, 1, 150) &&
             validOptString('code', 0, 50) &&
             data.type in ['Main Store', 'Floor Closet', 'Maintenance Room', 'Kitchen Store', 'Other'] &&
             validOptString('description', 0, 500) &&
             data.status in ['Active', 'Inactive'] &&
             validString(data.createdAt, 1, 50);
    }

    function isValidInventorySettings(data) {
      return hasRequiredFields([
               'id', 'organizationId', 'customCategories', 'customUnits',
               'updatedAt'
             ]) &&
             hasOnlyAllowedFields([
               'id', 'organizationId', 'customCategories', 'customUnits',
               'updatedAt'
             ]) &&
             validString(data.id, 1, 100) &&
             validString(data.organizationId, 1, 100) &&
             data.customCategories is list && data.customCategories.size() <= 100 &&
             data.customUnits is list && data.customUnits.size() <= 100 &&
             validString(data.updatedAt, 1, 50);
    }

    // ===============================================================
    // Root Rule: Default Deny
    // ===============================================================

    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Properties Collection & Subcollections
    // Authenticated users can read active properties.
    // Only 'owner' role can create, delete, or change status/code/owner-settings.
    // Assigned 'manager' role can update permitted operational fields only.
    // Subcollection members/{userId}:
    //   Read: Organization Owner, Property Manager, or doc owner.
    //   Write: Strictly Organization Owner.
    // Subcollection documents/{docId}:
    //   Read/Create/Update/Delete: Organization Owner or assigned active Manager.
    // Subcollection settings/{settingId}:
    //   Read: Organization Owner or assigned active Manager/Staff.
    //   Create/Update: Organization Owner or assigned active Manager (settingId == 'config').
    //   Delete: Strictly Organization Owner.
    // ===============================================================

    match /properties/{propertyId} {
      allow get: if isAuthenticated() && (isOrgOwner() || resource.data.status == 'active');
      allow list: if isAuthenticated();
      allow create: if isOrgOwner() && isValidProperty(request.resource.data);
      allow update: if isAuthenticated() &&
                       areImmutableFieldsUnchanged(['id', 'organizationId']) &&
                       isValidProperty(request.resource.data) &&
                       (
                         isOrgOwner() ||
                         (isOrgManager() &&
                          isActiveUser() &&
                          isAssignedToProperty(propertyId) &&
                          areImmutableFieldsUnchanged([
                            'id', 'organizationId', 'status', 'code', 'isArchived',
                            'createdAt', 'createdBy', 'deactivatedAt',
                            'deactivatedBy', 'deactivationReason', 'taxSettings', 'gstin'
                          ]))
                       );
      allow delete: if isOrgOwner();

      match /members/{userId} {
        allow get: if isAuthenticated() && (
          isOrgOwner() ||
          isManagerOrOwnerOfProperty(propertyId) ||
          isDocOwner(userId)
        );
        allow list: if isAuthenticated() && (
          isOrgOwner() ||
          isManagerOrOwnerOfProperty(propertyId)
        );
        allow create: if isAuthenticated() &&
                         isOrgOwner() &&
                         isValidPropertyMember(request.resource.data);
        allow update: if isAuthenticated() &&
                         isOrgOwner() &&
                         areImmutableFieldsUnchanged(['id', 'userId', 'propertyId', 'organizationId']) &&
                         isValidPropertyMember(request.resource.data);
        allow delete: if isAuthenticated() && isOrgOwner();
      }

      match /documents/{docId} {
        allow read: if isAuthenticated() && isActiveUser() && isManagerOrOwnerOfProperty(propertyId);
        allow create: if isAuthenticated() &&
                         isActiveUser() &&
                         isManagerOrOwnerOfProperty(propertyId) &&
                         isValidLodgeDocument(request.resource.data, propertyId, docId);
        allow update: if isAuthenticated() &&
                         isActiveUser() &&
                         isManagerOrOwnerOfProperty(propertyId) &&
                         areImmutableFieldsUnchanged(['id', 'lodgeId', 'organizationId', 'uploadedAt', 'uploadedByUid']) &&
                         isValidLodgeDocument(request.resource.data, propertyId, docId);
        allow delete: if isAuthenticated() && isActiveUser() && isManagerOrOwnerOfProperty(propertyId);
      }

      match /settings/{settingId} {
        allow read: if isAuthenticated() && isActiveUser() && isAssignedToProperty(propertyId);
        allow create: if isAuthenticated() &&
                         isActiveUser() &&
                         isManagerOrOwnerOfProperty(propertyId) &&
                         settingId == 'config' &&
                         isValidLodgeSettings(request.resource.data, propertyId);
        allow update: if isAuthenticated() &&
                         isActiveUser() &&
                         isManagerOrOwnerOfProperty(propertyId) &&
                         settingId == 'config' &&
                         areImmutableFieldsUnchanged(['lodgeId', 'organizationId']) &&
                         isValidLodgeSettings(request.resource.data, propertyId);
        allow delete: if isAuthenticated() && isOrgOwner();
      }
    }

    // ===============================================================
    // Lodge Codes Collection (Transaction-Safe Uniqueness Registry)
    // Read: Any active authenticated user in the organization.
    // Create/Update/Delete: Strictly Organization Owner.
    // ===============================================================

    match /lodgeCodes/{codeKey} {
      allow get: if isAuthenticated() && isActiveUser() && (
        isOrgOwner() ||
        resource == null ||
        resource.data.organizationId == getUserOrganizationId()
      );
      allow list: if isAuthenticated() && isActiveUser() && (
        isOrgOwner() ||
        resource.data.organizationId == getUserOrganizationId()
      );
      allow create: if isAuthenticated() &&
                       isOrgOwner() &&
                       isValidLodgeCode(request.resource.data);
      allow update: if isAuthenticated() &&
                       isOrgOwner() &&
                       areImmutableFieldsUnchanged(['organizationId', 'lodgeId']) &&
                       isValidLodgeCode(request.resource.data);
      allow delete: if isAuthenticated() && isOrgOwner();
    }

    // ===============================================================
    // User Profiles Collection (Centralized Owner-Controlled RBAC)
    // Read:
    //   - Document owner can read their own profile.
    //   - Owner and Manager can read profiles and list directory.
    // Create (Self-registration vs Administrative Provisioning):
    //   - Document owner self-registration: strictly pending status, role null/omitted, empty propertyIds and permissions.
    //   - Only Organization Owner can create profiles with roles ('owner', 'manager', 'staff') or active statuses.
    //   - Manager can create staff profiles only (role == 'staff').
    // Update:
    //   - Organization Owner can update any profile field (approvals, role, accountStatus, propertyIds, permissions).
    //   - Document owner (non-owner) can ONLY update personal info ('name', 'phone', 'updatedAt')
    //     and CANNOT change 'role', 'accountStatus', 'status', 'propertyIds', 'permissions', 'organizationId'.
    //   - Managers cannot promote themselves or alter roles of others.
    // Delete:
    //   - Strictly Organization Owner.
    // ===============================================================

    match /users/{userId} {
      allow get: if isAuthenticated() && (isDocOwner(userId) || isOrgOwner() || isOrgManager());
      allow list: if isAuthenticated() && (isOrgOwner() || isOrgManager());
      allow create: if isAuthenticated() && isValidUser(request.resource.data) && (
        // Organization Owner can create profiles for any role or active status
        isOrgOwner() ||
        // Manager can create staff profiles only
        (isOrgManager() && request.resource.data.role == 'staff') ||
        // Self-registration: User creating their own initial document with pending status, no role, no properties/permissions
        (isDocOwner(userId) &&
         (!('role' in request.resource.data) || request.resource.data.role == null) &&
         (!('accountStatus' in request.resource.data) || request.resource.data.accountStatus == 'pending') &&
         (!('status' in request.resource.data) || request.resource.data.status == 'pending') &&
         (('accountStatus' in request.resource.data && request.resource.data.accountStatus == 'pending') ||
          ('status' in request.resource.data && request.resource.data.status == 'pending')) &&
         (request.resource.data.propertyIds == [] || request.resource.data.propertyIds.size() == 0) &&
         (!('permissions' in request.resource.data) || request.resource.data.permissions == [] || request.resource.data.permissions.size() == 0))
      );
      allow update: if isAuthenticated() && isValidUser(request.resource.data) && areImmutableFieldsUnchanged(['uid']) && (
        // Organization Owner can update any user profile (approvals, role, accountStatus, propertyIds, permissions)
        isOrgOwner() ||
        // User (non-owner) can ONLY update personal info and CANNOT change role, accountStatus, status, propertyIds, permissions, organizationId
        (isDocOwner(userId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'updatedAt']) &&
         areImmutableFieldsUnchanged(['role', 'accountStatus', 'status', 'propertyIds', 'permissions', 'organizationId']))
      );
      allow delete: if isOrgOwner();
    }

    // ===============================================================
    // Rooms Management Collection
    // Read permitted for users assigned to propertyId (or Owner).
    // Write permitted for owner and manager of that property.
    // Assigned staff can transition room status & lastCleaned for operations.
    // ===============================================================

    match /rooms/{roomId} {
      allow get: if isAuthenticated() && (isOrgOwner() || isAssignedToProperty(docPropertyId(resource.data)));
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() &&
                       isManagerOrOwnerOfProperty(docPropertyId(request.resource.data)) &&
                       isValidRoom(request.resource.data);
      allow update: if isAuthenticated() &&
                       areImmutableFieldsUnchanged(['id', 'number']) &&
                       isValidRoom(request.resource.data) &&
                       (
                         // Owner and manager of the property have full update authority
                         isManagerOrOwnerOfProperty(docPropertyId(resource.data)) ||
                         // Assigned active staff can transition operational/housekeeping status, guest details, and cleaning timestamps
                         (isActiveUser() &&
                          isAssignedToProperty(docPropertyId(resource.data)) &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                            'status', 'operationalStatus', 'housekeepingStatus',
                            'lastCleaned', 'updatedAt', 'guestName', 'guestDate'
                          ]))
                       );
      allow delete: if isAuthenticated() && isManagerOrOwnerOfProperty(docPropertyId(resource.data));

      match /activity/{actId} {
        allow read: if isAuthenticated() &&
                       isActiveUser() &&
                       exists(/databases/$(database)/documents/rooms/$(roomId)) &&
                       (isOrgOwner() || isAssignedToProperty(docPropertyId(get(/databases/$(database)/documents/rooms/$(roomId)).data)));
        allow create: if isAuthenticated() &&
                         isActiveUser() &&
                         exists(/databases/$(database)/documents/rooms/$(roomId)) &&
                         (isOrgOwner() || isAssignedToProperty(docPropertyId(get(/databases/$(database)/documents/rooms/$(roomId)).data))) &&
                         isValidRoomActivity(request.resource.data, roomId, actId);
        allow update, delete: if false;
      }
    }

    // ===============================================================
    // Room Codes Collection (Transaction-Safe Uniqueness Registry)
    // Get/List: Active authenticated users in the organization (plus resource == null on get).
    // Create/Update/Delete: Owner or Manager of the property.
    // ===============================================================

    match /roomCodes/{codeKey} {
      allow get: if isAuthenticated() && isActiveUser() && (
        isOrgOwner() ||
        resource == null ||
        resource.data.organizationId == getUserOrganizationId()
      );
      allow list: if isAuthenticated() && isActiveUser() && (
        isOrgOwner() ||
        resource.data.organizationId == getUserOrganizationId()
      );
      allow create: if isAuthenticated() &&
                       isActiveUser() &&
                       isManagerOrOwnerOfProperty(request.resource.data.propertyId) &&
                       isValidRoomCode(request.resource.data);
      allow update: if isAuthenticated() &&
                       isActiveUser() &&
                       isManagerOrOwnerOfProperty(resource.data.propertyId) &&
                       areImmutableFieldsUnchanged(['propertyId', 'organizationId', 'roomId']) &&
                       isValidRoomCode(request.resource.data);
      allow delete: if isAuthenticated() &&
                       isActiveUser() &&
                       isManagerOrOwnerOfProperty(resource.data.propertyId);
    }

    // ===============================================================
    // Floors Collection
    // Read: Active authenticated users in the organization.
    // Create/Update/Delete: Owner or Manager of propertyId.
    // ===============================================================

    match /floors/{floorId} {
      allow get: if isAuthenticated() && isActiveUser() && (
        isOrgOwner() ||
        resource.data.organizationId == getUserOrganizationId()
      );
      allow list: if isAuthenticated() && isActiveUser();
      allow create: if isAuthenticated() &&
                       isActiveUser() &&
                       isManagerOrOwnerOfProperty(request.resource.data.propertyId) &&
                       isValidFloor(request.resource.data);
      allow update: if isAuthenticated() &&
                       isActiveUser() &&
                       isManagerOrOwnerOfProperty(resource.data.propertyId) &&
                       areImmutableFieldsUnchanged(['id', 'organizationId', 'propertyId']) &&
                       isValidFloor(request.resource.data);
      allow delete: if isAuthenticated() &&
                       isActiveUser() &&
                       isManagerOrOwnerOfProperty(resource.data.propertyId);
    }

    // ===============================================================
    // Room Types Collection
    // Read: Active authenticated users in the organization.
    // Create/Update/Delete: Owner or Manager.
    // ===============================================================

    match /roomTypes/{typeId} {
      allow get: if isAuthenticated() && isActiveUser() && (
        isOrgOwner() ||
        !('organizationId' in resource.data) ||
        resource.data.organizationId == getUserOrganizationId()
      );
      allow list: if isAuthenticated() && isActiveUser();
      allow create: if isAuthenticated() &&
                       isActiveUser() &&
                       (isOrgOwner() || isOrgManager()) &&
                       isValidRoomType(request.resource.data);
      allow update: if isAuthenticated() &&
                       isActiveUser() &&
                       (isOrgOwner() || isOrgManager()) &&
                       areImmutableFieldsUnchanged(['id', 'organizationId']) &&
                       isValidRoomType(request.resource.data);
      allow delete: if isAuthenticated() &&
                       isActiveUser() &&
                       (isOrgOwner() || isOrgManager());
    }

    // ===============================================================
    // Room Pricing Rules Collection
    // Read: Active authenticated users in the organization.
    // Create/Update/Delete: Owner or Manager of propertyId (Staff cannot write pricing).
    // ===============================================================

    match /roomPricing/{ruleId} {
      allow get: if isAuthenticated() && isActiveUser() && (
        isOrgOwner() ||
        resource.data.organizationId == getUserOrganizationId()
      );
      allow list: if isAuthenticated() && isActiveUser();
      allow create: if isAuthenticated() &&
                       isActiveUser() &&
                       isManagerOrOwnerOfProperty(request.resource.data.propertyId) &&
                       isValidRoomPricingRule(request.resource.data);
      allow update: if isAuthenticated() &&
                       isActiveUser() &&
                       isManagerOrOwnerOfProperty(resource.data.propertyId) &&
                       areImmutableFieldsUnchanged(['id', 'organizationId', 'propertyId']) &&
                       isValidRoomPricingRule(request.resource.data);
      allow delete: if isAuthenticated() &&
                       isActiveUser() &&
                       isManagerOrOwnerOfProperty(resource.data.propertyId);
    }

    // ===============================================================
    // Booking Reservations Collection
    // Read and write for authorized property roles.
    // ===============================================================

    match /bookings/{bookingId} {
      allow get: if isAuthenticated() && (isOrgOwner() || isAssignedToProperty(docPropertyId(resource.data)));
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() &&
                       isAssignedToProperty(docPropertyId(request.resource.data)) &&
                       isValidBooking(request.resource.data);
      allow update: if isAuthenticated() &&
                       isAssignedToProperty(docPropertyId(resource.data)) &&
                       areImmutableFieldsUnchanged(['id']) &&
                       isValidBooking(request.resource.data);
      allow delete: if isAuthenticated() && isManagerOrOwnerOfProperty(docPropertyId(resource.data));
    }

    // ===============================================================
    // Lodge Inventory Items Collection
    // Read and write for authorized property roles.
    // ===============================================================

    match /inventory/{itemId} {
      allow get: if isAuthenticated() && (isOrgOwner() || isAssignedToProperty(docPropertyId(resource.data)));
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() &&
                       isAssignedToProperty(docPropertyId(request.resource.data)) &&
                       isValidInventory(request.resource.data);
      allow update: if isAuthenticated() &&
                       isAssignedToProperty(docPropertyId(resource.data)) &&
                       areImmutableFieldsUnchanged(['id']) &&
                       isValidInventory(request.resource.data);
      allow delete: if isAuthenticated() && isManagerOrOwnerOfProperty(docPropertyId(resource.data));
    }

    // ===============================================================
    // Financial Expenses Collections (expenses and expense_records)
    // Read and write for authorized finance roles (Owner and Manager).
    // ===============================================================

    match /expenses/{expenseId} {
      allow get: if isAuthenticated() && (isOrgOwner() || (isOrgManager() && isAssignedToProperty(docPropertyId(resource.data))));
      allow list: if isAuthenticated() && (isOrgOwner() || isOrgManager());
      allow create: if isAuthenticated() &&
                       isManagerOrOwnerOfProperty(docPropertyId(request.resource.data)) &&
                       isValidExpense(request.resource.data);
      allow update: if isAuthenticated() &&
                       isManagerOrOwnerOfProperty(docPropertyId(resource.data)) &&
                       areImmutableFieldsUnchanged(['id']) &&
                       isValidExpense(request.resource.data);
      allow delete: if isAuthenticated() && isOrgOwner();
    }

    match /expense_records/{expenseId} {
      allow get: if isAuthenticated() && (isOrgOwner() || (isOrgManager() && isAssignedToProperty(docPropertyId(resource.data))));
      allow list: if isAuthenticated() && (isOrgOwner() || isOrgManager());
      allow create: if isAuthenticated() &&
                       isManagerOrOwnerOfProperty(docPropertyId(request.resource.data)) &&
                       isValidExpense(request.resource.data);
      allow update: if isAuthenticated() &&
                       isManagerOrOwnerOfProperty(docPropertyId(resource.data)) &&
                       areImmutableFieldsUnchanged(['id']) &&
                       isValidExpense(request.resource.data);
      allow delete: if isAuthenticated() && isOrgOwner();
    }

    // ===============================================================
    // Customer Records Collection
    // Read and write for authorized property roles.
    // ===============================================================

    match /customers/{customerId} {
      allow get: if isAuthenticated() && (isOrgOwner() || isAssignedToProperty(docPropertyId(resource.data)));
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() &&
                       isAssignedToProperty(docPropertyId(request.resource.data)) &&
                       isValidCustomer(request.resource.data);
      allow update: if isAuthenticated() &&
                       isAssignedToProperty(docPropertyId(resource.data)) &&
                       areImmutableFieldsUnchanged(['id']) &&
                       isValidCustomer(request.resource.data);
      allow delete: if isAuthenticated() && isManagerOrOwnerOfProperty(docPropertyId(resource.data));

      match /notes/{noteId} {
        allow read: if isAuthenticated() &&
                       isActiveUser() &&
                       exists(/databases/$(database)/documents/customers/$(customerId)) &&
                       (isOrgOwner() || isAssignedToProperty(docPropertyId(get(/databases/$(database)/documents/customers/$(customerId)).data)));
        allow create: if isAuthenticated() &&
                         isActiveUser() &&
                         exists(/databases/$(database)/documents/customers/$(customerId)) &&
                         (isOrgOwner() || isAssignedToProperty(docPropertyId(get(/databases/$(database)/documents/customers/$(customerId)).data))) &&
                         request.resource.data.authorUid == request.auth.uid &&
                         isValidCustomerNote(request.resource.data, customerId, noteId);
        allow update: if isAuthenticated() &&
                         isActiveUser() &&
                         exists(/databases/$(database)/documents/customers/$(customerId)) &&
                         (resource.data.authorUid == request.auth.uid ||
                          isManagerOrOwnerOfProperty(docPropertyId(get(/databases/$(database)/documents/customers/$(customerId)).data))) &&
                         areImmutableFieldsUnchanged(['id', 'customerId', 'authorUid', 'createdAt']) &&
                         isValidCustomerNote(request.resource.data, customerId, noteId);
        allow delete: if isAuthenticated() &&
                         isActiveUser() &&
                         exists(/databases/$(database)/documents/customers/$(customerId)) &&
                         (resource.data.authorUid == request.auth.uid ||
                          isManagerOrOwnerOfProperty(docPropertyId(get(/databases/$(database)/documents/customers/$(customerId)).data)));
      }

      match /activity/{actId} {
        allow read: if isAuthenticated() &&
                       isActiveUser() &&
                       exists(/databases/$(database)/documents/customers/$(customerId)) &&
                       (isOrgOwner() || isAssignedToProperty(docPropertyId(get(/databases/$(database)/documents/customers/$(customerId)).data)));
        allow create: if isAuthenticated() &&
                         isActiveUser() &&
                         exists(/databases/$(database)/documents/customers/$(customerId)) &&
                         (isOrgOwner() || isAssignedToProperty(docPropertyId(get(/databases/$(database)/documents/customers/$(customerId)).data))) &&
                         isValidCustomerActivity(request.resource.data, customerId, actId);
        allow update, delete: if false;
      }
    }

    // ===============================================================
    // Staff Management Collection
    // Read and write for Owner and Manager.
    // Staff members can read their own staff profile record.
    // ===============================================================

    match /staff/{staffId} {
      allow get: if isAuthenticated() && (
        isOrgOwner() ||
        isOrgManager() ||
        request.auth.uid == staffId ||
        ('email' in resource.data && resource.data.email == request.auth.token.email)
      );
      allow list: if isAuthenticated() && (isOrgOwner() || isOrgManager());
      allow create: if isAuthenticated() &&
                       isManagerOrOwnerOfProperty(docPropertyId(request.resource.data)) &&
                       isValidStaff(request.resource.data);
      allow update: if isAuthenticated() &&
                       isManagerOrOwnerOfProperty(docPropertyId(resource.data)) &&
                       areImmutableFieldsUnchanged(['id']) &&
                       isValidStaff(request.resource.data);
      allow delete: if isAuthenticated() && isOrgOwner();
    }

    // ===============================================================
    // Housekeeping Tasks Collection
    // Read: Active authenticated Owner or users assigned to propertyId
    // Create / Delete: Active Owner or Manager of propertyId
    // Update: Owner/Manager (full), or assigned/claiming active Staff (cleaning fields only)
    // ===============================================================

    match /housekeeping/{taskId} {
      allow get: if isAuthenticated() && isActiveUser() && (isOrgOwner() || isAssignedToProperty(docPropertyId(resource.data)));
      allow list: if isAuthenticated() && isActiveUser();
      allow create: if isAuthenticated() &&
                       isActiveUser() &&
                       isManagerOrOwnerOfProperty(docPropertyId(request.resource.data)) &&
                       isValidHousekeeping(request.resource.data);
      allow update: if isAuthenticated() &&
                       isActiveUser() &&
                       isAssignedToProperty(docPropertyId(resource.data)) &&
                       areImmutableFieldsUnchanged(['id', 'organizationId', 'propertyId']) &&
                       isValidHousekeeping(request.resource.data) &&
                       (
                         // Owner and manager of the property can update any task field
                         isManagerOrOwnerOfProperty(docPropertyId(resource.data)) ||
                         // Assigned staff (or staff claiming an unassigned task) can update cleaning progress fields
                         (
                           (
                             ('assignedStaffId' in resource.data && resource.data.assignedStaffId == request.auth.uid) ||
                             ('assignedToUid' in resource.data && resource.data.assignedToUid == request.auth.uid) ||
                             ((!('assignedStaffId' in resource.data) || resource.data.assignedStaffId == null || resource.data.assignedStaffId == '') &&
                              (!('assignedToUid' in resource.data) || resource.data.assignedToUid == null || resource.data.assignedToUid == ''))
                           ) &&
                           request.resource.data.status in ['Assigned', 'In Progress', 'Completed', 'Inspection Pending'] &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                             'status', 'notes', 'photos', 'missingItems', 'maintenanceIssueId',
                             'assignee', 'assignedTo', 'assignedToUid', 'assignedStaffId',
                             'startedAt', 'completedAt', 'updatedAt'
                           ])
                         )
                       );
      allow delete: if isAuthenticated() && isActiveUser() && isManagerOrOwnerOfProperty(docPropertyId(resource.data));
    }

    // ===============================================================
    // Housekeeping Inspections Collection (Immutable Audit Trail)
    // Read: Active authenticated Owner or users assigned to propertyId
    // Create: Owner or Manager of propertyId; non-Owners cannot approve their own cleaning task
    // Update / Delete: Strictly immutable (false)
    // ===============================================================

    match /housekeepingInspections/{inspId} {
      allow get: if isAuthenticated() &&
                    isActiveUser() &&
                    (isOrgOwner() || isAssignedToProperty(resource.data.propertyId));
      allow list: if isAuthenticated() && isActiveUser();
      allow create: if isAuthenticated() &&
                       isActiveUser() &&
                       isManagerOrOwnerOfProperty(request.resource.data.propertyId) &&
                       (!('taskAssignedToUid' in request.resource.data) ||
                        request.resource.data.taskAssignedToUid == null ||
                        request.resource.data.taskAssignedToUid != request.auth.uid ||
                        isOrgOwner()) &&
                       isValidHousekeepingInspection(request.resource.data);
      allow update, delete: if false;
    }

    // ===============================================================
    // Maintenance Issues Collection
    // Read: Active authenticated Owner or users assigned to propertyId
    // Create: Active authenticated users assigned to propertyId (reportedByUid == auth.uid)
    // Update: Active Owner or Manager of propertyId
    // Delete: Organization Owner only
    // ===============================================================

    match /maintenanceIssues/{issueId} {
      allow get: if isAuthenticated() &&
                    isActiveUser() &&
                    (isOrgOwner() || isAssignedToProperty(resource.data.propertyId));
      allow list: if isAuthenticated() && isActiveUser();
      allow create: if isAuthenticated() &&
                       isActiveUser() &&
                       isAssignedToProperty(request.resource.data.propertyId) &&
                       request.resource.data.reportedByUid == request.auth.uid &&
                       isValidMaintenanceIssue(request.resource.data);
      allow update: if isAuthenticated() &&
                       isActiveUser() &&
                       isManagerOrOwnerOfProperty(resource.data.propertyId) &&
                       areImmutableFieldsUnchanged([
                         'id', 'organizationId', 'propertyId', 'roomId',
                         'reportedByUid', 'createdAt'
                       ]) &&
                       isValidMaintenanceIssue(request.resource.data);
      allow delete: if isAuthenticated() && isOrgOwner();
    }

    // ===============================================================
    // Guest Payments & Financial Transactions Collection
    // Read: Authenticated Owner or users assigned to doc's propertyId
    // List: Authenticated (Owner or users assigned to property)
    // Create: Active authenticated users assigned to request propertyId
    // Update: Active authenticated Owner or Manager of property, id & numericAmount immutable
    // Delete: Only Organization Owner
    // ===============================================================

    match /payments/{paymentId} {
      allow get: if isAuthenticated() && (isOrgOwner() || isAssignedToProperty(docPropertyId(resource.data)));
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() &&
                       isActiveUser() &&
                       isAssignedToProperty(docPropertyId(request.resource.data)) &&
                       isValidPayment(request.resource.data);
      allow update: if isAuthenticated() &&
                       isActiveUser() &&
                       isManagerOrOwnerOfProperty(docPropertyId(resource.data)) &&
                       areImmutableFieldsUnchanged(['id', 'numericAmount']) &&
                       isValidPayment(request.resource.data);
      allow delete: if isAuthenticated() && isOrgOwner();
    }

    // ===============================================================
    // Refunds Collection
    // Get: Active authenticated users with access to propertyId
    // List: Active authenticated users (property-filtered in BillingService)
    // Create: Active authenticated users assigned to propertyId
    //         (requestedByUid == request.auth.uid, refundAmount > 0, refundStatus == 'Requested')
    // Update: Only Owner or Manager of propertyId with immutable core fields
    // Delete: Only Organization Owner
    // ===============================================================

    match /refunds/{refundId} {
      allow get: if isAuthenticated() &&
                    isActiveUser() &&
                    (isOrgOwner() || isAssignedToProperty(resource.data.propertyId));
      allow list: if isAuthenticated() && isActiveUser();
      allow create: if isAuthenticated() &&
                       isActiveUser() &&
                       isAssignedToProperty(request.resource.data.propertyId) &&
                       request.resource.data.requestedByUid == request.auth.uid &&
                       request.resource.data.refundAmount is number &&
                       request.resource.data.refundAmount > 0 &&
                       request.resource.data.refundStatus == 'Requested' &&
                       isValidRefund(request.resource.data);
      allow update: if isAuthenticated() &&
                       isActiveUser() &&
                       isManagerOrOwnerOfProperty(resource.data.propertyId) &&
                       areImmutableFieldsUnchanged([
                         'id', 'organizationId', 'propertyId', 'bookingId',
                         'paymentId', 'refundAmount', 'requestedByUid', 'createdAt'
                       ]) &&
                       isValidRefund(request.resource.data);
      allow delete: if isAuthenticated() && isOrgOwner();
    }

    // ===============================================================
    // Invoices Collection (Immutable Historical Snapshots)
    // Get: Active authenticated users with access to propertyId
    // List: Active authenticated users (property-filtered in BillingService)
    // Create: Active authenticated users with isManagerOrOwnerOfProperty or property assignment
    // Update / Delete: Owner only
    // ===============================================================

    match /invoices/{invoiceId} {
      allow get: if isAuthenticated() &&
                    isActiveUser() &&
                    (isOrgOwner() || isAssignedToProperty(resource.data.propertyId));
      allow list: if isAuthenticated() && isActiveUser();
      allow create: if isAuthenticated() &&
                       isActiveUser() &&
                       (isManagerOrOwnerOfProperty(request.resource.data.propertyId) ||
                        isAssignedToProperty(request.resource.data.propertyId)) &&
                       isValidInvoice(request.resource.data);
      allow update: if isAuthenticated() &&
                       isOrgOwner() &&
                       areImmutableFieldsUnchanged(['id', 'organizationId', 'propertyId', 'bookingId', 'issuedAt']) &&
                       isValidInvoice(request.resource.data);
      allow delete: if isAuthenticated() && isOrgOwner();
    }

    // ===============================================================
    // Idempotency Keys Collection (Transaction-Safe Duplicate Prevention)
    // Get / Create: Active authenticated users (for runTransaction checks)
    // List / Update / Delete: false
    // ===============================================================

    match /idempotencyKeys/{key} {
      allow get: if isAuthenticated() && isActiveUser();
      allow list: if false;
      allow create: if isAuthenticated() &&
                       isActiveUser() &&
                       isValidIdempotencyKey(request.resource.data, key);
      allow update, delete: if false;
    }

    // ===============================================================
    // Inventory Stock Movements Collection
    // Read & List: Authenticated Owner or users assigned to propertyId
    // Create: Authenticated users assigned to propertyId
    // Update: Authenticated Owner or Manager of property, id immutable
    // Delete: Only Organization Owner
    // ===============================================================

    match /inventory_movements/{movementId} {
      allow get: if isAuthenticated() && (isOrgOwner() || isAssignedToProperty(docPropertyId(resource.data)));
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() &&
                       isAssignedToProperty(docPropertyId(request.resource.data)) &&
                       isValidInventoryMovement(request.resource.data);
      allow update: if isAuthenticated() &&
                       isManagerOrOwnerOfProperty(docPropertyId(resource.data)) &&
                       areImmutableFieldsUnchanged(['id']) &&
                       isValidInventoryMovement(request.resource.data);
      allow delete: if isAuthenticated() && isOrgOwner();
    }

    // ===============================================================
    // Staff & Employee Audit Logs Collection
    // Read & List: Authenticated Organization Owner or Manager
    // Create: Authenticated Organization Owner or Manager with actorUid == request.auth.uid
    // Update & Delete: Strictly immutable (false)
    // ===============================================================

    match /staffAuditLogs/{logId} {
      allow get, list: if isAuthenticated() && (isOrgOwner() || isOrgManager());
      allow create: if isAuthenticated() &&
                       (isOrgOwner() || isOrgManager()) &&
                       request.resource.data.actorUid == request.auth.uid &&
                       isValidStaffAuditLog(request.resource.data);
      allow update, delete: if false;
    }

    // ===============================================================
    // Page 09: Maintenance & Inventory Management Collections
    // ===============================================================

    match /maintenanceRequests/{requestId} {
      allow get: if isActiveUser() &&
                    belongsToOrganization(resource.data.organizationId) &&
                    (isOrgOwner() || isAssignedToProperty(resource.data.propertyId));
      allow list: if isActiveUser() && belongsToOrganization(resource.data.organizationId);
      allow create: if isActiveUser() &&
                       belongsToOrganization(request.resource.data.organizationId) &&
                       isAssignedToProperty(request.resource.data.propertyId) &&
                       request.resource.data.reportedByUid == request.auth.uid &&
                       request.resource.data.status == 'Reported' &&
                       isValidMaintenanceRequest(request.resource.data);
      allow update: if isActiveUser() &&
                       belongsToOrganization(resource.data.organizationId) &&
                       areImmutableFieldsUnchanged(['id', 'organizationId', 'propertyId', 'reportedByUid', 'reportedAt']) &&
                       isValidMaintenanceRequest(request.resource.data) &&
                       (
                         isManagerOrOwnerOfProperty(resource.data.propertyId) ||
                         (
                           isAssignedToProperty(resource.data.propertyId) &&
                           resource.data.reportedByUid == request.auth.uid &&
                           resource.data.status == 'Reported' &&
                           request.resource.data.status == 'Reported' &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes', 'photos', 'updatedAt'])
                         )
                       );
      allow delete: if isActiveUser() &&
                       isOrgOwner() &&
                       belongsToOrganization(resource.data.organizationId);
    }

    match /workOrders/{workOrderId} {
      allow get: if isActiveUser() &&
                    belongsToOrganization(resource.data.organizationId) &&
                    (isOrgOwner() || isAssignedToProperty(resource.data.propertyId));
      allow list: if isActiveUser() && belongsToOrganization(resource.data.organizationId);
      allow create: if isActiveUser() &&
                       belongsToOrganization(request.resource.data.organizationId) &&
                       isManagerOrOwnerOfProperty(request.resource.data.propertyId) &&
                       request.resource.data.createdByUid == request.auth.uid &&
                       isValidWorkOrder(request.resource.data);
      allow update: if isActiveUser() &&
                       belongsToOrganization(resource.data.organizationId) &&
                       areImmutableFieldsUnchanged(['id', 'workOrderNumber', 'organizationId', 'propertyId', 'createdByUid', 'createdAt']) &&
                       isValidWorkOrder(request.resource.data) &&
                       (
                         isManagerOrOwnerOfProperty(resource.data.propertyId) ||
                         (
                           'assignedTechnicianUid' in resource.data &&
                           resource.data.assignedTechnicianUid == request.auth.uid &&
                           isAssignedToProperty(resource.data.propertyId) &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                             'status', 'issuedItems', 'linkedPurchaseOrderIds',
                             'completionNotes', 'afterPhotos', 'labourCost',
                             'materialCost', 'totalCost', 'completedAt', 'updatedAt'
                           ]) &&
                           !(request.resource.data.status in ['Verified', 'Closed'])
                         )
                       );
      allow delete: if isActiveUser() &&
                       isOrgOwner() &&
                       belongsToOrganization(resource.data.organizationId);
    }

    match /suppliers/{supplierId} {
      allow get, list: if isActiveUser() && belongsToOrganization(resource.data.organizationId);
      allow create: if isActiveUser() &&
                       belongsToOrganization(request.resource.data.organizationId) &&
                       (isOrgOwner() || isOrgManager()) &&
                       isValidSupplier(request.resource.data);
      allow update: if isActiveUser() &&
                       belongsToOrganization(resource.data.organizationId) &&
                       (isOrgOwner() || isOrgManager()) &&
                       areImmutableFieldsUnchanged(['id', 'organizationId', 'createdAt']) &&
                       isValidSupplier(request.resource.data);
      allow delete: if isActiveUser() &&
                       isOrgOwner() &&
                       belongsToOrganization(resource.data.organizationId);
    }

    match /purchaseOrders/{poId} {
      allow get: if isActiveUser() &&
                    belongsToOrganization(resource.data.organizationId) &&
                    (isOrgOwner() || isAssignedToProperty(resource.data.propertyId));
      allow list: if isActiveUser() && belongsToOrganization(resource.data.organizationId);
      allow create: if isActiveUser() &&
                       belongsToOrganization(request.resource.data.organizationId) &&
                       isManagerOrOwnerOfProperty(request.resource.data.propertyId) &&
                       request.resource.data.createdByUid == request.auth.uid &&
                       isValidPurchaseOrder(request.resource.data);
      allow update: if isActiveUser() &&
                       belongsToOrganization(resource.data.organizationId) &&
                       isManagerOrOwnerOfProperty(resource.data.propertyId) &&
                       areImmutableFieldsUnchanged(['id', 'poNumber', 'organizationId', 'propertyId', 'createdByUid', 'createdAt']) &&
                       isValidPurchaseOrder(request.resource.data) &&
                       (
                         !(resource.data.status == 'Pending Approval' && request.resource.data.status == 'Approved') ||
                         isOrgOwner()
                       );
      allow delete: if isActiveUser() &&
                       isOrgOwner() &&
                       belongsToOrganization(resource.data.organizationId);
    }

    match /stockTransfers/{transferId} {
      allow get: if isActiveUser() &&
                    belongsToOrganization(resource.data.organizationId) &&
                    (
                      isOrgOwner() ||
                      isAssignedToProperty(resource.data.sourcePropertyId) ||
                      isAssignedToProperty(resource.data.destinationPropertyId)
                    );
      allow list: if isActiveUser() && belongsToOrganization(resource.data.organizationId);
      allow create: if isActiveUser() &&
                       belongsToOrganization(request.resource.data.organizationId) &&
                       isManagerOrOwnerOfProperty(request.resource.data.sourcePropertyId) &&
                       request.resource.data.requestedByUid == request.auth.uid &&
                       request.resource.data.sourcePropertyId != request.resource.data.destinationPropertyId &&
                       isValidStockTransfer(request.resource.data);
      allow update: if isActiveUser() &&
                       belongsToOrganization(resource.data.organizationId) &&
                       (
                         isOrgOwner() ||
                         (
                           isOrgManager() &&
                           (
                             isAssignedToProperty(resource.data.sourcePropertyId) ||
                             isAssignedToProperty(resource.data.destinationPropertyId)
                           )
                         )
                       ) &&
                       areImmutableFieldsUnchanged([
                         'id', 'organizationId', 'sourcePropertyId',
                         'destinationPropertyId', 'sourceItemId',
                         'requestedByUid', 'createdAt'
                       ]) &&
                       isValidStockTransfer(request.resource.data);
      allow delete: if isActiveUser() &&
                       isOrgOwner() &&
                       belongsToOrganization(resource.data.organizationId);
    }

    match /storageLocations/{locationId} {
      allow get, list: if isActiveUser() && belongsToOrganization(resource.data.organizationId);
      allow create: if isActiveUser() &&
                       belongsToOrganization(request.resource.data.organizationId) &&
                       isManagerOrOwnerOfProperty(request.resource.data.propertyId) &&
                       isValidStorageLocation(request.resource.data);
      allow update: if isActiveUser() &&
                       belongsToOrganization(resource.data.organizationId) &&
                       isManagerOrOwnerOfProperty(request.resource.data.propertyId) &&
                       areImmutableFieldsUnchanged(['id', 'organizationId', 'propertyId', 'createdAt']) &&
                       isValidStorageLocation(request.resource.data);
      allow delete: if isActiveUser() &&
                       isOrgOwner() &&
                       belongsToOrganization(resource.data.organizationId);
    }

    match /inventorySettings/{orgId} {
      allow get: if isActiveUser() && belongsToOrganization(orgId);
      allow create, update: if isActiveUser() &&
                               isOrgOwner() &&
                               belongsToOrganization(orgId) &&
                               request.resource.data.organizationId == orgId &&
                               isValidInventorySettings(request.resource.data);
      allow delete: if false;
    }
  }
}
