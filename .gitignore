# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

# Dependencies
/node_modules
/npm-debug.log*
/yarn-error.log*
/yarn-debug.log*
/pnpm-debug.log*

# Build / output
/www
/dist
/out-tsc
/tmp
/build
*.tsbuildinfo

# Angular / Ionic / Sass caches
/.angular
/.ionic
/.sass-cache
/.sourcemaps
/.versions

# Capacitor / Cordova native
/android
/ios
/platforms
/plugins

# Test / coverage
/coverage
/cypress/videos
/cypress/screenshots
*.lcov

# Environment & secrets (keep example files tracked)
.env
.env.*
!.env.example
*.pem
*.p12
*.keystore
google-services.json
GoogleService-Info.plist

# IDE / editor
/.idea
/.vscode/*
!/.vscode/extensions.json
*.sublime-project
*.sublime-workspace
*.sw[mnpcod]
*~

# OS junk
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
UserInterfaceState.xcuserstate

# Logs & temp
*.log
log.txt
*.tmp
*.tmp.*
.tmp
